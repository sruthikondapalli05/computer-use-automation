# Anthropic API key used by the LLM discovery agent (src/discovery_agent.py).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for vision + reasoning during discovery.
CLAUDE_MODEL=claude-sonnet-5

# Run Playwright headless (true) or show the browser window (false).
HEADLESS=true

# Default per-action timeout, in milliseconds, for both discovery and replay.
ACTION_TIMEOUT_MS=10000
